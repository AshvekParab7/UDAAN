# Django
DJANGO_SECRET_KEY=replace-me-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: sqlite (default) or postgresql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=udaan
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Gemini API (keep the real key in backend/.env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated capacity fallbacks, tried if the selected model stays busy
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Optional team invitation email. Leave SMTP values blank to use secure copyable links.
FRONTEND_BASE_URL=http://127.0.0.1:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
